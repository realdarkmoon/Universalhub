 429 | class AlertEngine:
 430 |     """Evaluates telemetry frames against SLA thresholds with deduplication cooldowns."""
 431 | 
 432 |     def __init__(self, latency_sla_ms: float, error_budget_pct: float, cooldown_ticks: int = 8) -> None:
 433 |         self.latency_sla_ms = latency_sla_ms
 434 |         self.error_budget_pct = error_budget_pct
 435 |         self.cooldown_ticks = cooldown_ticks
 436 |         self._last_fired: Dict[Tuple[str, str], int] = {}
 437 |         self.history: List[AlertEvent] = []
 438 | 
 439 |     def _can_emit(self, node_id: str, code: str, tick: int) -> bool:
 440 |         key = (node_id, code)
 441 |         prev = self._last_fired.get(key)
 442 |         if prev is not None and (tick - prev) < self.cooldown_ticks:
 443 |             return False
 444 |         self._last_fired[key] = tick
 445 |         return True
 446 | 
 447 |     def evaluate(self, frame: TelemetryFrame) -> List[AlertEvent]:
 448 |         emitted: List[AlertEvent] = []
 449 |         checks: List[Tuple[bool, AlertSeverity, str, str, float, float]] = [
 450 |             (
 451 |                 frame.p99_ms > self.latency_sla_ms * 1.5,
 452 |                 AlertSeverity.CRITICAL,
 453 |                 "LATENCY_SLA_BREACH_CRIT",
 454 |                 f"p99 latency {frame.p99_ms:.1f}ms exceeded 1.5x SLA",
 455 |                 frame.p99_ms,
 456 |                 self.latency_sla_ms * 1.5,
 457 |             ),
 458 |             (
 459 |                 frame.p99_ms > self.latency_sla_ms and frame.p99_ms <= self.latency_sla_ms * 1.5,
 460 |                 AlertSeverity.WARN,
 461 |                 "LATENCY_SLA_WARN",
 462 |                 f"p99 latency {frame.p99_ms:.1f}ms above SLA target",
 463 |                 frame.p99_ms,
 464 |                 self.latency_sla_ms,
 465 |             ),
 466 |             (
 467 |                 frame.error_rate_pct > self.error_budget_pct * 4.0,
 468 |                 AlertSeverity.ERROR,
 469 |                 "ERROR_BUDGET_BURN",
 470 |                 f"Error rate {frame.error_rate_pct:.2f}% burning error budget",
 471 |                 frame.error_rate_pct,
 472 |                 self.error_budget_pct * 4.0,
 473 |             ),
 474 |             (
 475 |                 frame.cpu_pct > 90.0,
 476 |                 AlertSeverity.CRITICAL,
 477 |                 "CPU_SATURATION",
 478 |                 f"CPU utilization reached {frame.cpu_pct:.1f}%",
 479 |                 frame.cpu_pct,
 480 |                 90.0,
 481 |             ),
 482 |             (
 483 |                 frame.queue_depth > 1500,
 484 |                 AlertSeverity.WARN,
 485 |                 "QUEUE_BACKPRESSURE",
 486 |                 f"Queue depth at {frame.queue_depth} items",
 487 |                 float(frame.queue_depth),
 488 |                 1500.0,
 489 |             ),
 490 |         ]
 491 |         for triggered, severity, code, msg, val, thresh in checks:
 492 |             if triggered and self._can_emit(frame.node_id, code, frame.tick):
 493 |                 ev = AlertEvent(
 494 |                     alert_id=f"alr-{uuid.uuid4().hex[:10]}",
 495 |                     timestamp_utc=frame.timestamp_utc,
 496 |                     tick=frame.tick,
 497 |                     node_id=frame.node_id,
 498 |                     severity=severity,
 499 |                     code=code,
 500 |                     message=msg,
 501 |                     metric_value=round(val, 3),
 502 |                     threshold=round(thresh, 3),
 503 |                 )
 504 |                 emitted.append(ev)
 505 |                 self.history.append(ev)
 506 |         return emitted
