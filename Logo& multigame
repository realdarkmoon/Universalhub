 291 | class GridNode:
 292 |     """Simulated compute/storage worker node emitting synthetic telemetry."""
 293 | 
 294 |     def __init__(
 295 |         self,
 296 |         node_id: str,
 297 |         zone: str,
 298 |         rng: random.Random,
 299 |         capacity_rps: float = 1200.0,
 300 |     ) -> None:
 301 |         self.node_id = node_id
 302 |         self.zone = zone
 303 |         self.rng = rng
 304 |         self.capacity_rps = capacity_rps
 305 |         self.weight: float = 1.0
 306 |         self.state: NodeState = NodeState.BOOTING
 307 |         self.cpu_pct: float = 14.0
 308 |         self.mem_pct: float = 32.0
 309 |         self.queue_depth: int = 0
 310 |         self.rps: float = 0.0
 311 |         self.p50_ms: float = 12.0
 312 |         self.p99_ms: float = 48.0
 313 |         self.error_rate_pct: float = 0.01
 314 |         self.ticks_in_state: int = 0
 315 |         self.total_requests: int = 0
 316 |         self.total_errors: int = 0
 317 |         self.breaker = CircuitBreaker()
 318 |         self.latency_win = ExponentialMovingWindow(maxlen=120, alpha=0.18)
 319 |         self.cpu_win = ExponentialMovingWindow(maxlen=120, alpha=0.12)
 320 | 
 321 |     def transition_to(self, new_state: NodeState) -> None:
 322 |         if self.state != new_state:
 323 |             self.state = new_state
 324 |             self.ticks_in_state = 0
 325 | 
 326 |     def _demand_multiplier(self, tick: int, profile: WorkloadProfile) -> float:
 327 |         if profile == WorkloadProfile.STEADY:
 328 |             return 0.55 + self.rng.uniform(-0.04, 0.04)
 329 |         if profile == WorkloadProfile.DIURNAL:
 330 |             phase = (tick % 240) / 240.0 * 2.0 * math.pi
 331 |             wave = 0.55 + 0.35 * math.sin(phase - math.pi / 3.0)
 332 |             return max(0.12, wave + self.rng.uniform(-0.05, 0.05))
 333 |         if profile == WorkloadProfile.BURSTY:
 334 |             burst = 1.45 if (tick % 45) < 7 else 0.42
 335 |             return max(0.10, burst + self.rng.uniform(-0.08, 0.12))
 336 |         if profile == WorkloadProfile.CHAOS:
 337 |             spike = 1.85 if self.rng.random() < 0.14 else 0.65
 338 |             return max(0.10, spike + self.rng.uniform(-0.15, 0.25))
 339 |         return 0.50
 340 | 
 341 |     def step(self, tick: int, dt_sec: float, profile: WorkloadProfile) -> TelemetryFrame:
 342 |         self.ticks_in_state += 1
 343 |         if self.state == NodeState.BOOTING and self.ticks_in_state >= 4:
 344 |             self.transition_to(NodeState.HEALTHY)
 345 | 
 346 |         if self.state == NodeState.QUARANTINED and self.ticks_in_state >= 24:
 347 |             self.transition_to(NodeState.DRAINING)
 348 |         elif self.state == NodeState.DRAINING and self.ticks_in_state >= 8:
 349 |             self.transition_to(NodeState.HEALTHY)
 350 | 
 351 |         demand = self._demand_multiplier(tick, profile)
 352 |         effective_cap = self.capacity_rps * self.weight
 353 | 
 354 |         if self.state in (NodeState.OFFLINE, NodeState.QUARANTINED):
 355 |             target_rps = 0.0
 356 |         elif self.state == NodeState.DRAINING:
 357 |             target_rps = effective_cap * demand * 0.25
 358 |         else:
 359 |             target_rps = effective_cap * demand
 360 | 
 361 |         allowed = self.breaker.allow_request(tick)
 362 |         if not allowed:
 363 |             target_rps *= 0.05
 364 | 
 365 |         self.rps = round((0.72 * self.rps) + (0.28 * target_rps), 2)
 366 |         utilization = min(1.45, self.rps / max(1.0, effective_cap))
 367 | 
 368 |         overload = max(0.0, utilization - 0.85)
 369 |         incoming_backlog = int(max(0.0, (self.rps - effective_cap * 0.90) * dt_sec * 4.0))
 370 |         drained = int(self.queue_depth * 0.35) + (0 if overload > 0.15 else 12)
 371 |         self.queue_depth = max(0, min(5000, self.queue_depth + incoming_backlog - drained))
 372 | 
 373 |         target_cpu = 12.0 + (utilization * 68.0) + (overload * 45.0) + self.rng.uniform(-2.5, 2.5)
 374 |         self.cpu_pct = round(max(2.0, min(99.9, (0.75 * self.cpu_pct) + (0.25 * target_cpu))), 2)
 375 | 
 376 |         mem_drift = (utilization - 0.50) * 1.4 + self.rng.uniform(-0.4, 0.45)
 377 |         self.mem_pct = round(max(18.0, min(96.5, self.mem_pct + mem_drift)), 2)
 378 | 
 379 |         base_p50 = 10.5 + (utilization ** 2) * 28.0 + (self.queue_depth * 0.04)
 380 |         self.p50_ms = round(max(4.0, base_p50 + self.rng.uniform(-1.8, 2.2)), 2)
 381 | 
 382 |         tail_penalty = (overload ** 2.4) * 420.0 + (self.queue_depth * 0.19)
 383 |         raw_p99 = (self.p50_ms * 3.4) + tail_penalty + self.rng.uniform(-6.0, 14.0)
 384 |         self.p99_ms = round(max(self.p50_ms + 5.0, min(2500.0, raw_p99)), 2)
 385 | 
 386 |         err_base = 0.015 + (overload ** 2.0) * 6.5
 387 |         if self.state == NodeState.DEGRADED:
 388 |             err_base += 0.35
 389 |         self.error_rate_pct = round(max(0.0, min(25.0, err_base + self.rng.uniform(-0.01, 0.04))), 4)
 380 | 
 391 |         reqs_this_tick = int(self.rps * dt_sec)
 392 |         errs_this_tick = int(round(reqs_this_tick * (self.error_rate_pct / 100.0)))
 393 |         self.total_requests += reqs_this_tick
 394 |         self.total_errors += errs_this_tick
 395 | 
 396 |         success_tick = (self.p99_ms < 450.0) and (self.error_rate_pct < 2.0)
 397 |         self.breaker.record_outcome(tick, success_tick)
 398 | 
 399 |         if self.state not in (NodeState.BOOTING, NodeState.OFFLINE, NodeState.QUARANTINED, NodeState.DRAINING):
 400 |             if self.cpu_pct > 92.0 or self.error_rate_pct > 4.5 or self.breaker.state == "OPEN":
 401 |                 self.transition_to(NodeState.QUARANTINED)
 402 |             elif self.cpu_pct > 78.0 or self.p99_ms > 220.0 or self.error_rate_pct > 0.8:
 403 |                 self.transition_to(NodeState.DEGRADED)
 404 |             else:
 405 |                 self.transition_to(NodeState.HEALTHY)
 406 | 
 407 |         self.latency_win.add(self.p99_ms)
 408 |         self.cpu_win.add(self.cpu_pct)
 409 | 
 410 |         now_iso = datetime.now(timezone.utc).isoformat()
 411 |         frame = TelemetryFrame(
 412 |             frame_id=f"frm-{tick:06d}-{self.node_id}",
 413 |             node_id=self.node_id,
 414 |             zone=self.zone,
 415 |             timestamp_utc=now_iso,
 416 |             tick=tick,
 417 |             cpu_pct=self.cpu_pct,
 418 |             mem_pct=self.mem_pct,
 419 |             queue_depth=self.queue_depth,
 420 |             rps=self.rps,
 421 |             p50_ms=self.p50_ms,
 422 |             p99_ms=self.p99_ms,
 423 |             error_rate_pct=self.error_rate_pct,
 424 |             state=self.state,
 425 |         )
 426 |         return frame.finalize()
