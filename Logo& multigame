 591 | class GridClusterController:
 592 |     """Coordinates nodes, routing ring, alerts, load balancing, and snapshots."""
 593 | 
 594 |     def __init__(self, config: GridConfig) -> None:
 595 |         config.validate()
 596 |         self.config = config
 597 |         self.rng = random.Random(config.seed)
 598 |         self.ring = ConsistentHashRing(replicas=128)
 599 |         self.alerts = AlertEngine(
 600 |             latency_sla_ms=config.latency_sla_ms,
 601 |             error_budget_pct=config.error_budget_pct,
 602 |         )
 603 |         self.balancer = LoadBalancer(self.ring)
 604 |         self.buffer = TelemetryBuffer(capacity=config.max_queue)
 605 |         self.nodes: Dict[str, GridNode] = {}
 606 |         self.tick_count: int = 0
 607 |         self.rebalance_log: List[RebalancePlan] = []
 608 |         self.snapshots: List[Dict[str, Any]] = []
 609 |         self._hooks: List[Callable[[int, List[TelemetryFrame]], Coroutine[Any, Any, None]]] = []
 610 |         self._init_nodes()
 611 | 
 612 |     def _init_nodes(self) -> None:
 613 |         zones = [f"{self.config.region}{suffix}" for suffix in ("a", "b", "c")]
 614 |         for idx in range(self.config.node_count):
 615 |             zone = zones[idx % len(zones)]
 616 |             node_id = f"node-{idx:03d}"
 617 |             cap = self.rng.choice([1000.0, 1200.0, 1500.0])
 618 |             node = GridNode(node_id=node_id, zone=zone, rng=self.rng, capacity_rps=cap)
 619 |             self.nodes[node_id] = node
 620 |             self.ring.add_node(node_id, weight=1.0)
 621 | 
 622 |     def register_hook(self, hook: Callable[[int, List[TelemetryFrame]], Coroutine[Any, Any, None]]) -> None:
 623 |         self._hooks.append(hook)
 624 | 
 625 |     def route_partition(self, partition_key: str) -> Optional[str]:
 626 |         primary = self.ring.lookup(partition_key)
 627 |         if primary and primary in self.nodes:
 628 |             node = self.nodes[primary]
 629 |             if node.state in (NodeState.HEALTHY, NodeState.DEGRADED):
 630 |                 return primary
 631 |         for candidate in sorted(self.nodes.values(), key=lambda n: n.cpu_pct):
 632 |             if candidate.state == NodeState.HEALTHY:
 633 |                 return candidate.node_id
 634 |         return primary
 635 | 
 636 |     def build_snapshot(self) -> Dict[str, Any]:
 637 |         active = list(self.nodes.values())
 638 |         total_rps = round(sum(n.rps for n in active), 2)
 639 |         avg_cpu = round(sum(n.cpu_pct for n in active) / max(1, len(active)), 2)
 640 |         avg_mem = round(sum(n.mem_pct for n in active) / max(1, len(active)), 2)
 641 |         max_p99 = round(max((n.p99_ms for n in active), default=0.0), 2)
 642 |         state_counts: Dict[str, int] = {}
 643 |         for st in NodeState:
 644 |             state_counts[st.value] = sum(1 for n in active if n.state == st)
 645 |         return {
 646 |             "schema_version": SCHEMA_VERSION,
 647 |             "region": self.config.region,
 648 |             "tick": self.tick_count,
 649 |             "timestamp_utc": datetime.now(timezone.utc).isoformat(),
 650 |             "total_rps": total_rps,
 651 |             "avg_cpu_pct": avg_cpu,
 652 |             "avg_mem_pct": avg_mem,
 653 |             "max_p99_ms": max_p99,
 654 |             "state_counts": state_counts,
 655 |             "buffer": self.buffer.stats(),
 656 |             "alerts_total": len(self.alerts.history),
 657 |         }
 658 | 
 659 |     async def step_once(self) -> List[TelemetryFrame]:
 660 |         self.tick_count += 1
 661 |         dt_sec = self.config.tick_ms / 1000.0
 662 |         frames: List[TelemetryFrame] = []
 663 | 
 664 |         for node in self.nodes.values():
 665 |             frame = node.step(self.tick_count, dt_sec, self.config.profile)
 666 |             frames.append(frame)
 667 |             new_alerts = self.alerts.evaluate(frame)
 668 |             for alr in new_alerts:
 669 |                 LOGGER.warning(
 670 |                     "[tick=%d node=%s sev=%s code=%s] %s",
 671 |                     alr.tick,
 672 |                     alr.node_id,
 673 |                     alr.severity.value,
 674 |                     alr.code,
 675 |                     alr.message,
 676 |                 )
 677 | 
 678 |         self.buffer.append_batch(frames)
 679 | 
 680 |         if self.config.enable_auto_rebalance and (self.tick_count % 6 == 0):
 681 |             plans = self.balancer.compute_rebalance(self.tick_count, self.nodes)
 682 |             self.rebalance_log.extend(plans)
 683 | 
 684 |         if self.tick_count % self.config.snapshot_interval_ticks == 0:
 685 |             snap = self.build_snapshot()
 686 |             self.snapshots.append(snap)
 687 | 
 688 |         for hook in self._hooks:
 689 |             await hook(self.tick_count, frames)
 690 | 
 691 |         return frames
 692 | 
 693 |     async def run_for_ticks(self, total_ticks: int, stop_event: Optional[asyncio.Event] = None) -> Dict[str, Any]:
 694 |         sleep_sec = self.config.tick_ms / 1000.0
 695 |         for _ in range(total_ticks):
 696 |             if stop_event is not None and stop_event.is_set():
 697 |                 break
 698 |             await self.step_once()
 699 |             await asyncio.sleep(sleep_sec)
 700 |         return self.summarize()
 701 | 
 702 |     def summarize(self) -> Dict[str, Any]:
 703 |         total_reqs = sum(n.total_requests for n in self.nodes.values())
 704 |         total_errs = sum(n.total_errors for n in self.nodes.values())
 705 |         err_pct = (total_errs / total_reqs * 100.0) if total_reqs > 0 else 0.0
 706 |         p99_peaks = [n.latency_win.percentile(99.0) for n in self.nodes.values() if n.latency_win.samples]
 707 |         cluster_p99 = round(max(p99_peaks, default=0.0), 2)
 708 |         return {
 709 |             "schema_version": SCHEMA_VERSION,
 710 |             "region": self.config.region,
 711 |             "profile": self.config.profile.value,
 712 |             "ticks_executed": self.tick_count,
 713 |             "nodes": len(self.nodes),
 714 |             "total_requests": total_reqs,
 715 |             "total_errors": total_errs,
 716 |             "overall_error_rate_pct": round(err_pct, 4),
 717 |             "cluster_p99_ms": cluster_p99,
 718 |             "rebalance_actions": len(self.rebalance_log),
 719 |             "alerts_emitted": len(self.alerts.history),
 720 |             "snapshots_captured": len(self.snapshots),
 721 |             "ring_distribution_pct": self.ring.distribution_stats(),
 722 |         }
