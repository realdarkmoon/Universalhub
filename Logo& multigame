 261 | class ExponentialMovingWindow:
 262 |     """Bounded sliding window with EWMA and percentile approximations."""
 263 | 
 264 |     def __init__(self, maxlen: int = 120, alpha: float = 0.15) -> None:
 265 |         self.maxlen = maxlen
 266 |         self.alpha = alpha
 267 |         self.samples: Deque[float] = deque(maxlen=maxlen)
 268 |         self.ewma: Optional[float] = None
 269 | 
 270 |     def add(self, value: float) -> None:
 271 |         self.samples.append(value)
 272 |         if self.ewma is None:
 273 |             self.ewma = value
 274 |         else:
 275 |             self.ewma = (self.alpha * value) + ((1.0 - self.alpha) * self.ewma)
 276 | 
 277 |     def percentile(self, pct: float) -> float:
 278 |         if not self.samples:
 279 |             return 0.0
 280 |         ordered = sorted(self.samples)
 281 |         idx = int(round((pct / 100.0) * (len(ordered) - 1)))
 282 |         idx = max(0, min(len(ordered) - 1, idx))
 283 |         return ordered[idx]
 284 | 
 285 |     def mean(self) -> float:
 286 |         if not self.samples:
 287 |             return 0.0
 288 |         return sum(self.samples) / len(self.samples)
