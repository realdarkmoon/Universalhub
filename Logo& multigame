 943 | def compute_cluster_health_score(summary: Dict[str, Any]) -> float:
 944 |     err_rate = float(summary.get("overall_error_rate_pct", 0.0))
 945 |     p99 = float(summary.get("cluster_p99_ms", 0.0))
