 509 | class LoadBalancer:
 510 |     """Computes weight adjustments to smooth CPU and queue skew across healthy nodes."""
 511 | 
 512 |     def __init__(self, ring: ConsistentHashRing, min_weight: float = 0.25, max_weight: float = 2.00) -> None:
 513 |         self.ring = ring
 514 |         self.min_weight = min_weight
 515 |         self.max_weight = max_weight
 516 | 
 517 |     def compute_rebalance(self, tick: int, nodes: Dict[str, GridNode]) -> List[RebalancePlan]:
 518 |         healthy = [
 519 |             n for n in nodes.values()
 520 |             if n.state in (NodeState.HEALTHY, NodeState.DEGRADED)
 521 |         ]
 522 |         if len(healthy) < 2:
 523 |             return []
 524 | 
 525 |         avg_cpu = sum(n.cpu_pct for n in healthy) / len(healthy)
 526 |         plans: List[RebalancePlan] = []
 527 | 
 528 |         overloaded = sorted(
 529 |             [n for n in healthy if n.cpu_pct > avg_cpu + 12.0],
 530 |             key=lambda n: n.cpu_pct,
 531 |             reverse=True,
 532 |         )
 533 |         underloaded = sorted(
 534 |             [n for n in healthy if n.cpu_pct < avg_cpu - 12.0],
 535 |             key=lambda n: n.cpu_pct,
 536 |         )
 537 | 
 538 |         for src, dst in zip(overloaded, underloaded):
 539 |             delta = 0.15
 540 |             new_src_w = max(self.min_weight, round(src.weight - delta, 2))
 541 |             new_dst_w = min(self.max_weight, round(dst.weight + delta, 2))
 542 |             if new_src_w != src.weight and new_dst_w != dst.weight:
 543 |                 src.weight = new_src_w
 544 |                 dst.weight = new_dst_w
 545 |                 self.ring.set_weight(src.node_id, new_src_w)
 546 |                 self.ring.set_weight(dst.node_id, new_dst_w)
 547 |                 plans.append(
 548 |                     RebalancePlan(
 549 |                         plan_id=f"reb-{tick:06d}-{src.node_id}->{dst.node_id}",
 550 |                         tick=tick,
 551 |                         source_node=src.node_id,
 552 |                         target_node=dst.node_id,
 553 |                         weight_delta=delta,
 554 |                         reason=f"CPU skew {src.cpu_pct:.1f}% vs {dst.cpu_pct:.1f}% (avg {avg_cpu:.1f}%)",
 555 |                     )
 556 |                 )
