 147 | class ConsistentHashRing:
 148 |     """Consistent hash ring with virtual nodes for deterministic shard routing."""
 149 | 
 150 |     def __init__(self, replicas: int = 128) -> None:
 151 |         self.replicas = replicas
 152 |         self._entries: List[RingEntry] = []
 153 |         self._slots: List[int] = []
 154 |         self._node_weights: Dict[str, float] = {}
 155 | 
 156 |     @staticmethod
 157 |     def _hash_key(key: str) -> int:
 158 |         digest = hashlib.blake2b(key.encode("utf-8"), digest_size=8).digest()
 159 |         return int.from_bytes(digest, byteorder="big", signed=False)
 160 | 
 161 |     def add_node(self, node_id: str, weight: float = 1.0) -> None:
 162 |         self._node_weights[node_id] = max(0.05, weight)
 163 |         self._rebuild()
 164 | 
 165 |     def remove_node(self, node_id: str) -> None:
 166 |         self._node_weights.pop(node_id, None)
 167 |         self._rebuild()
 168 | 
 169 |     def set_weight(self, node_id: str, weight: float) -> None:
 170 |         if node_id in self._node_weights:
 171 |             self._node_weights[node_id] = max(0.05, weight)
 172 |             self._rebuild()
 173 | 
 174 |     def _rebuild(self) -> None:
 175 |         entries: List[RingEntry] = []
 176 |         for node_id, weight in sorted(self._node_weights.items()):
 177 |             vnodes = max(1, int(round(self.replicas * weight)))
 178 |             for idx in range(vnodes):
 179 |                 slot = self._hash_key(f"{node_id}#vnode-{idx}")
 180 |                 entries.append(RingEntry(hash_slot=slot, node_id=node_id, replica_idx=idx))
 181 |         entries.sort(key=lambda item: item.hash_slot)
 182 |         self._entries = entries
 183 |         self._slots = [item.hash_slot for item in entries]
 184 | 
 185 |     def lookup(self, partition_key: str) -> Optional[str]:
 190 |         if not self._entries:
 191 |             return None
 192 |         target = self._hash_key(partition_key)
 193 |         lo, hi = 0, len(self._slots)
 194 |         while lo < hi:
 195 |             mid = (lo + hi) // 2
 196 |             if self._slots[mid] < target:
 197 |                 lo = mid + 1
 198 |             else:
 199 |                 hi = mid
 200 |         idx = lo if lo < len(self._slots) else 0
 201 |         return self._entries[idx].node_id
 202 | 
 203 |     def distribution_stats(self) -> Dict[str, float]:
 204 |         if not self._entries:
 205 |             return {}
 206 |         counts: Dict[str, int] = {node: 0 for node in self._node_weights}
 207 |         for entry in self._entries:
 208 |             counts[entry.node_id] = counts.get(entry.node_id, 0) + 1
 209 |         total = len(self._entries)
 210 |         return {node: round((cnt / total) * 100.0, 2) for node, cnt in counts.items()}
