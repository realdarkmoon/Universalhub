 560 | class TelemetryBuffer:
 561 |     """Thread/coroutine-friendly bounded ring buffer for recent telemetry frames."""
 562 | 
 563 |     def __init__(self, capacity: int = 4096) -> None:
 564 |         self.capacity = capacity
 565 |         self._frames: Deque[TelemetryFrame] = deque(maxlen=capacity)
 566 |         self._dropped: int = 0
 567 | 
 568 |     def append_batch(self, frames: Iterable[TelemetryFrame]) -> int:
 569 |         added = 0
 570 |         for frame in frames:
 571 |             if len(self._frames) >= self.capacity:
 572 |                 self._dropped += 1
 573 |             self._frames.append(frame)
 574 |             added += 1
 575 |         return added
 576 | 
 577 |     def latest(self, count: int = 24) -> List[TelemetryFrame]:
 578 |         if count <= 0:
 579 |             return []
 570 |         items = list(self._frames)
 581 |         return items[-count:]
 582 | 
 583 |     def stats(self) -> Dict[str, int]:
 584 |         return {
 585 |             "buffered": len(self._frames),
 586 |             "capacity": self.capacity,
 587 |             "dropped": self._dropped,
 588 |         }
