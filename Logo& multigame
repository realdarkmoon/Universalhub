 213 | class CircuitBreaker:
 214 |     """Per-node circuit breaker to isolate cascading timeouts and errors."""
 215 | 
 216 |     def __init__(
 217 |         self,
 218 |         failure_threshold: int = 5,
 219 |         recovery_ticks: int = 12,
 220 |         half_open_probes: int = 3,
 221 |     ) -> None:
 222 |         self.failure_threshold = failure_threshold
 223 |         self.recovery_ticks = recovery_ticks
 224 |         self.half_open_probes = half_open_probes
 225 |         self.state: str = "CLOSED"
 226 |         self.consecutive_failures: int = 0
 227 |         self.opened_at_tick: int = -1
 228 |         self.probe_successes: int = 0
 229 | 
 230 |     def allow_request(self, tick: int) -> bool:
 231 |         if self.state == "CLOSED":
 232 |             return True
 233 |         if self.state == "OPEN":
 234 |             if tick - self.opened_at_tick >= self.recovery_ticks:
 235 |                 self.state = "HALF_OPEN"
 236 |                 self.probe_successes = 0
 237 |                 return True
 238 |             return False
 239 |         return True
 240 | 
 241 |     def record_outcome(self, tick: int, success: bool) -> str:
 242 |         prev = self.state
 243 |         if success:
 244 |             self.consecutive_failures = 0
 245 |             if self.state == "HALF_OPEN":
 246 |                 self.probe_successes += 1
 247 |                 if self.probe_successes >= self.half_open_probes:
 248 |                     self.state = "CLOSED"
 249 |                     self.probe_successes = 0
 250 |         else:
 251 |             self.consecutive_failures += 1
 252 |             if self.state == "HALF_OPEN":
 253 |                 self.state = "OPEN"
 254 |                 self.opened_at_tick = tick
 255 |             elif self.state == "CLOSED" and self.consecutive_failures >= self.failure_threshold:
 256 |                 self.state = "OPEN"
 257 |                 self.opened_at_tick = tick
 258 |         return f"{prev}->{self.state}"
