    local function updateFovCircle()
        if not fovCircleOn then
            if fovCircleDrawing then
                pcall(function() fovCircleDrawing.Visible=false end)
            end
            return
        end
        local cam=workspace.CurrentCamera
        if not cam then return end
        local c=ensureFovCircle()
        if not c then return end
        local center=Vector2.new(cam.ViewportSize.X*0.5,cam.ViewportSize.Y*0.5)
        pcall(function()
            c.Position=center
            c.Radius=aimFovRadius
            c.Color=C.ACCENT
            c.Visible=true
        end)
    end

    local function isSameTeam(p)
        if not teamCheckOn then return false end
        if player.Team and p.Team then
            return player.Team==p.Team
        end
        if player.TeamColor and p.TeamColor then
            return player.TeamColor==p.TeamColor
        end
        return false
    end

    local function getClosestTargetPart()
        local cam=workspace.CurrentCamera
        if not cam then return nil end
        local center=Vector2.new(cam.ViewportSize.X*0.5,cam.ViewportSize.Y*0.5)
        local bestPart=nil
        local bestDist=math.huge

        for _,p in ipairs(Players:GetPlayers()) do
            if p~=player and not isSameTeam(p) and p.Character then
                local hum=p.Character:FindFirstChildOfClass("Humanoid")
                local part=aimHeadPart and (p.Character:FindFirstChild("Head") or p.Character:FindFirstChild("HumanoidRootPart"))
                    or (p.Character:FindFirstChild("HumanoidRootPart") or p.Character:FindFirstChild("Head"))
                if hum and hum.Health>0 and part then
                    local screenPos,onScreen=cam:WorldToViewportPoint(part.Position)
                    if onScreen and screenPos.Z>0 then
                        local dist=(Vector2.new(screenPos.X,screenPos.Y)-center).Magnitude
                        if (not fovCircleOn or dist<=aimFovRadius) and dist<bestDist then
                            bestDist=dist
                            bestPart=part
                        end
                    end
                end
            end
        end

        return bestPart
    end

    local function aimCameraAt(part,smoothAlpha)
        local cam=workspace.CurrentCamera
        if not cam or not part then return end
        local goalCFrame=CFrame.new(cam.CFrame.Position,part.Position)
        if smoothAlpha and smoothAlpha<1 then
            cam.CFrame=cam.CFrame:Lerp(goalCFrame,smoothAlpha)
        else
            cam.CFrame=goalCFrame
        end
    end

