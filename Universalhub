    local function restoreInvisibility()

        for obj,origVal in pairs(invisBackup) do

            if obj and obj.Parent then

                pcall(function()

                    if obj:IsA("BasePart") or obj:IsA("Decal") or obj:IsA("Texture") then

                        obj.Transparency=origVal

                    elseif obj:IsA("BillboardGui") then

                        obj.Enabled=origVal

                    end

                end)

            end

        end

        invisBackup={}

    end



    local function applyInvisibility()

        local char=player.Character

        if not char then return end

        for _,desc in ipairs(char:GetDescendants()) do

            if desc:IsA("BasePart") then

                if invisBackup[desc]==nil then

                    invisBackup[desc]=desc.Transparency

                end

                if desc.Name=="HumanoidRootPart" then

                    desc.Transparency=1

                else

                    -- Keep a soft self-visible ghost alpha on local view while hiding part from others

                    desc.Transparency=math.max(invisBackup[desc] or 0,0.65)

                end

            elseif desc:IsA("Decal") or desc:IsA("Texture") then

                if invisBackup[desc]==nil then

                    invisBackup[desc]=desc.Transparency

                end

                desc.Transparency=math.max(invisBackup[desc] or 0,0.55)

            elseif desc:IsA("BillboardGui") then

                if invisBackup[desc]==nil then

                    invisBackup[desc]=desc.Enabled

                end

                desc.Enabled=true

            end

        end

    end



