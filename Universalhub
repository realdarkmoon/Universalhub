    local function findJoint(char, names)

        for _,desc in ipairs(char:GetDescendants()) do

            if desc:IsA("Motor6D") then

                for _,n in ipairs(names) do

                    if desc.Name==n or (desc.Part1 and desc.Part1.Name==n) then

                        return desc

                    end

                end

            end

        end

        return nil

    end



    local function capturePoseJoints(char)

        savedJoints={}

        if not char then return end

        local specs={

            waist={"Waist","RootJoint"},

            neck={"Neck"},

            rShoulder={"RightShoulder","Right Shoulder"},

            lShoulder={"LeftShoulder","Left Shoulder"},

            rHip={"RightHip","Right Hip"},

            lHip={"LeftHip","Left Hip"},

            rKnee={"RightKnee"},

            lKnee={"LeftKnee"}

        }

        for key,names in pairs(specs) do

            local j=findJoint(char,names)

            if j then

                savedJoints[key]={joint=j,c0=j.C0}

            end

        end

    end



    local function applyJointOffset(entry, offsetCFrame, alpha)

        if not entry or not entry.joint or not entry.joint.Parent then return end

        local goal=entry.c0*offsetCFrame

        entry.joint.C0=entry.joint.C0:Lerp(goal,math.clamp(alpha,0,1))

    end



    local function restorePoseJoints()

        for _,entry in pairs(savedJoints) do

            if entry and entry.joint and entry.joint.Parent then

                pcall(function()

                    entry.joint.C0=entry.c0

                end)

            end

        end

        savedJoints={}

    end



    local function restoreAntiFlingCollisions()

        for part,canCollide in pairs(antiFlingCache) do

            if part and part.Parent then

                pcall(function() part.CanCollide=canCollide end)

            end

        end

        antiFlingCache={}

    end



    local function stepAntiFling()

        if not antiFlingOn then return end



        for _,p in ipairs(Players:GetPlayers()) do

            if p~=player and p.Character then

                for _,desc in ipairs(p.Character:GetDescendants()) do

                    if desc:IsA("BasePart") then

                        if antiFlingCache[desc]==nil then

                            antiFlingCache[desc]=desc.CanCollide

                        end

                        desc.CanCollide=false

                    end

                end

            end

        end



        local char,root,_=getChar()

        if not char or not root then return end



        local maxLinVel=flying and math.max(flySpeed*1.35,140) or 110

        local maxAngVel=28



        for _,desc in ipairs(char:GetDescendants()) do

            if desc:IsA("BasePart") then

                local lv=desc.AssemblyLinearVelocity

                if lv.Magnitude>maxLinVel then

                    local clampedY=flying and lv.Y or math.clamp(lv.Y,-maxLinVel,85)

                    local horiz=Vector3.new(lv.X,0,lv.Z)

                    if horiz.Magnitude>maxLinVel then

                        horiz=horiz.Unit*maxLinVel

                    end

                    desc.AssemblyLinearVelocity=Vector3.new(horiz.X,clampedY,horiz.Z)

                end



                local av=desc.AssemblyAngularVelocity

                if av.Magnitude>maxAngVel then

                    desc.AssemblyAngularVelocity=av.Unit*maxAngVel

                end

            end

        end

    end



    local function stepAntiVoid()

        if not antiVoidOn then return end

        local char,root,hum=getChar()

        if not char or not root or not hum or hum.Health<=0 then return end



        if root.Position.Y>voidThreshold+25 and hum.FloorMaterial~=Enum.Material.Air then

            lastSafeCFrame=root.CFrame+Vector3.new(0,3,0)

        end



        if root.Position.Y<voidThreshold then

            root.AssemblyLinearVelocity=Vector3.zero

            root.AssemblyAngularVelocity=Vector3.zero

            if lastSafeCFrame then

                root.CFrame=lastSafeCFrame

            else

                root.CFrame=CFrame.new(root.Position.X,math.max(voidThreshold+90,45),root.Position.Z)

            end

            setStatus("ANTI-VOID SAVED")

        end

    end



    local function clearWebVisual()

        if webBeam then pcall(function() webBeam:Destroy() end) webBeam=nil end

        if rootAtt then pcall(function() rootAtt:Destroy() end) rootAtt=nil end

        if anchorAtt then pcall(function() anchorAtt:Destroy() end) anchorAtt=nil end

        if webAnchor then pcall(function() webAnchor:Destroy() end) webAnchor=nil end

    end



    local function stopFly()

        flying=false

        swingPhase=0

        if flyConn then flyConn:Disconnect() flyConn=nil end

        if bv then pcall(function() bv:Destroy() end) bv=nil end

        if bg then pcall(function() bg:Destroy() end) bg=nil end

        clearWebVisual()

        restorePoseJoints()

        local _,_,hum=getChar()

        if hum then hum.PlatformStand=false end

    end



    local function getWebAnchor(root,cam,char)

        local rayParams=RaycastParams.new()

        rayParams.FilterType=Enum.RaycastFilterType.Exclude

        if char then rayParams.FilterDescendantsInstances={char} end

        local dir=(cam.CFrame.LookVector*0.45+Vector3.new(0,0.85,0)).Unit*140

        local hit=workspace:Raycast(root.Position+Vector3.new(0,2,0),dir,rayParams)

        if hit then return hit.Position end

        return root.Position+cam.CFrame.LookVector*36+Vector3.new(0,48,0)

    end



    local function ensureWebVisual(root,anchorPos)

        if not root or not root.Parent then return end

        if not webAnchor or not webAnchor.Parent then

            webAnchor=make("Part",{

                Name="DarkMoonWebAnchor",

                Size=Vector3.new(0.2,0.2,0.2),

                Anchored=true,

                CanCollide=false,

                Transparency=1

            },workspace)

        end

        webAnchor.Position=anchorPos



        if not rootAtt or not rootAtt.Parent then

            rootAtt=make("Attachment",{Name="DarkMoonRootAtt"},root)

        end

        if not anchorAtt or not anchorAtt.Parent then

            anchorAtt=make("Attachment",{Name="DarkMoonAnchorAtt"},webAnchor)

        end

        if not webBeam or not webBeam.Parent then

            webBeam=make("Beam",{

                Name="DarkMoonWebLine",

                Attachment0=rootAtt,

                Attachment1=anchorAtt,

                Color=ColorSequence.new(C.ACCENT,Color3.new(1,1,1)),

                Width0=0.14,

                Width1=0.08,

                FaceCamera=true,

                LightEmission=0.4

            },webAnchor)

        end

    end



    local function updateSpiderBodyPose(curRoot,lookDir,roll,pitch,swingArc,dt)

        local blend=math.clamp((dt or 0.016)*12,0.1,1)

        local reachRight=swingArc>=0



        applyJointOffset(

            savedJoints.waist,

            CFrame.Angles(0.14+math.abs(pitch)*0.25,math.sin(swingPhase)*0.22,-roll*0.45),

            blend

        )

        applyJointOffset(

            savedJoints.neck,

            CFrame.Angles(-pitch*0.45-0.12,0,-roll*0.35),

            blend

        )



        if reachRight then

            local lift=0.55+math.max(0,swingArc)*0.45

            applyJointOffset(

                savedJoints.rShoulder,

                CFrame.Angles(math.rad(125+lift*35),0,math.rad(-22)),

                blend

            )

            applyJointOffset(

                savedJoints.lShoulder,

                CFrame.Angles(math.rad(-28-swingArc*18),0,math.rad(26)),

                blend

            )

        else

            local lift=0.55+math.max(0,-swingArc)*0.45

            applyJointOffset(

                savedJoints.lShoulder,

                CFrame.Angles(math.rad(125+lift*35),0,math.rad(22)),

                blend

            )

            applyJointOffset(

                savedJoints.rShoulder,

                CFrame.Angles(math.rad(-28+swingArc*18),0,math.rad(-26)),

                blend

            )

        end



        local legKick=math.sin(swingPhase)*0.32

        applyJointOffset(

            savedJoints.rHip,

            CFrame.Angles(-0.38+legKick,0.08,-0.08),

            blend

        )

        applyJointOffset(

            savedJoints.lHip,

            CFrame.Angles(-0.22-legKick,-0.08,0.08),

            blend

        )

        applyJointOffset(

            savedJoints.rKnee,

            CFrame.Angles(-math.max(0,0.45+legKick*0.7),0,0),

            blend

        )

        applyJointOffset(

            savedJoints.lKnee,

            CFrame.Angles(-math.max(0,0.35-legKick*0.7),0,0),

            blend

        )



        local baseCFrame=CFrame.lookAt(curRoot.Position,curRoot.Position+lookDir)

        bg.CFrame=baseCFrame*CFrame.Angles(pitch,0,roll)

    end



    local function startFly()

        stopFly()

        local char,root,hum=getChar()

        if not root or not hum then return false end

        flying=true

        swingPhase=0

        capturePoseJoints(char)

        bv=make("BodyVelocity",{MaxForce=Vector3.new(1e6,1e6,1e6),P=18000,Velocity=Vector3.zero},root)

        bg=make("BodyGyro",{MaxTorque=Vector3.new(1e6,1e6,1e6),P=14000,CFrame=root.CFrame},root)

        hum.PlatformStand=true



        flyConn=RunService.RenderStepped:Connect(function(dt)

            local curChar,curRoot,curHum=getChar()

            if not flying or not curChar or not curRoot or not curRoot.Parent or not curHum then

                stopFly()

                return

            end

            if not bv or not bv.Parent or not bg or not bg.Parent then

                stopFly()

                return

            end



            local cam=workspace.CurrentCamera

            if not cam then return end



            local moveDir=Vector3.zero

            local verticalInput=0



            if not UIS:GetFocusedTextBox() then

                local forward=Vector3.new(cam.CFrame.LookVector.X,0,cam.CFrame.LookVector.Z)

                if forward.Magnitude>1e-4 then forward=forward.Unit else forward=Vector3.new(0,0,-1) end

                local rightVec=Vector3.new(cam.CFrame.RightVector.X,0,cam.CFrame.RightVector.Z)

                if rightVec.Magnitude>1e-4 then rightVec=rightVec.Unit else rightVec=Vector3.new(1,0,0) end



                if UIS:IsKeyDown(Enum.KeyCode.W) then moveDir=moveDir+forward end

                if UIS:IsKeyDown(Enum.KeyCode.S) then moveDir=moveDir-forward end

                if UIS:IsKeyDown(Enum.KeyCode.D) then moveDir=moveDir+rightVec end

                if UIS:IsKeyDown(Enum.KeyCode.A) then moveDir=moveDir-rightVec end

                if UIS:IsKeyDown(Enum.KeyCode.Space) then verticalInput=verticalInput+1 end

                if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then verticalInput=verticalInput-1 end

            end



            local stickDir=curHum.MoveDirection

            if stickDir.Magnitude>0.05 then

                moveDir=moveDir+Vector3.new(stickDir.X,0,stickDir.Z)

            end

            if os.clock()<mobileJumpBoostUntil then

                verticalInput=verticalInput+1

            end



            if moveDir.Magnitude>1 then moveDir=moveDir.Unit end



            local activeMove=moveDir.Magnitude>0.05 or math.abs(verticalInput)>0.05

            swingPhase=swingPhase+(dt or 0.016)*(activeMove and 5.4 or 1.8)

            local swingArc=math.sin(swingPhase)

            local pendulumLift=swingArc*(flySpeed*0.18)

            local targetVel=moveDir*flySpeed+Vector3.new(0,verticalInput*(flySpeed*0.75)+pendulumLift,0)



            local currentVel=bv.Velocity

            bv.Velocity=currentVel:Lerp(targetVel,math.clamp((dt or 0.016)*9,0.08,1))



            local anchorPos=getWebAnchor(curRoot,cam,curChar)

            ensureWebVisual(curRoot,anchorPos)



            local lookDir=moveDir.Magnitude>0.05 and moveDir or Vector3.new(cam.CFrame.LookVector.X,0,cam.CFrame.LookVector.Z)

            if lookDir.Magnitude<1e-4 then lookDir=Vector3.new(0,0,-1) else lookDir=lookDir.Unit end

            local pitch=-math.clamp(bv.Velocity.Y/math.max(flySpeed,1),-0.45,0.55)-0.16

            local roll=-swingArc*0.24

            updateSpiderBodyPose(curRoot,lookDir,roll,pitch,swingArc,dt)

        end)

        return true

    end



